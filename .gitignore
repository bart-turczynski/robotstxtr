.env
.env.*
!.env.example
*.log
.DS_Store

.fp/
_scratch/

# Heavy artifacts — never commit (a big blob bloats .git history even after deletion).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.faiss
*.npy
*.npz
vectors/

.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
*.Rcheck/
*.tar.gz
src/*.o
src/*.so
src/*.dll
# Also ignore build artifacts under vendored subdirectories (defensive: the
# VPATH build emits objects at top-level src/, but guard against a stray add).
src/**/*.o
src/**/*.so
src/**/*.dll
vignettes/*.html
vignettes/*.pdf
doc/
Meta/

# NOTE: tests/testthat/_snaps/ is deliberately NOT ignored. It was listed here
# among the build artifacts in the initial scaffold, but testthat snapshots are
# test source of truth, not generated output: they must be committed to assert
# anything. While they were ignored, every expect_snapshot() call silently took
# the "creating new snapshot" path on a clean checkout and in CI -- a warning
# and zero assertions -- so a snapshot test would have looked green while
# testing nothing.

# Fiberplane local issue tracking
.fp/
docs
