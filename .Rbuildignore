# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^\.covrignore$
^cran-comments\.md$
^CRAN-SUBMISSION$
^LICENSE\.md$
^THIRD_PARTY_NOTICES\.md$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.gitlab$
^\.gitlab-ci\.yml$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.fp$
^\.claude$
^_scratch$
^dev$
^data-raw$
^docs$
^design$
^CLAUDE\.md$
^AGENTS\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CHANGELOG\.md$
^\.DS_Store$
^_pkgdown\.yml$
^pkgdown$
^README\.Rmd$
^codemeta\.json$
^CITATION\.cff$
^\.zenodo\.json$
^SECURITY-INSIGHTS\.yml$
^CODE_OF_CONDUCT\.md$
# The citation gate ported from seor (design/adr/0002 there). Not part
# of the installable package; without this, --as-cran reports it as a
# non-standard top-level directory.
^scripts$
# The CI job library. `R_LIBS_USER` points here and `cache:` carries it, so
# once SEOR-dyzgzyot made the cached library actually populate, `R CMD check`
# would see a hidden directory full of installed packages inside the package
# source. seor carries the same entry for the same reason; punycoder hit the
# WARNING for real before this was added here.
^\.r-lib$
# In a git worktree .git is a regular file (a gitdir: pointer), which R CMD build
# does not exclude the way it does a .git directory; it would ship as a hidden file.
^\.git$
# Logs and build output for the house workflow. Without this, R CMD build copies
# it into the tarball and the check reports a top-level-files NOTE.
^tmp$
