# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^\.covrignore$
^cran-comments\.md$
^CRAN-SUBMISSION$
^LICENSE\.md$
^THIRD_PARTY_NOTICES\.md$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.gitlab$
^\.gitlab-ci\.yml$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.oss-scanner$
^\.fp$
^\.claude$
^_scratch$
^dev$
^data-raw$
^docs$
^design$
^CLAUDE\.md$
^AGENTS\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CHANGELOG\.md$
^\.DS_Store$
^_pkgdown\.yml$
^pkgdown$
^README\.Rmd$
^codemeta\.json$
^CITATION\.cff$
^\.zenodo\.json$
^SECURITY-INSIGHTS\.yml$
^\.bestpractices\.json$
^CODE_OF_CONDUCT\.md$
^ARCHITECTURE\.md$
# The citation gate ported from seor (design/adr/0002 there). Not part
# of the installable package; without this, --as-cran reports it as a
# non-standard top-level directory.
^scripts$
# A local R library some setups keep in the package directory: `R CMD check`
# would otherwise see a hidden directory full of installed packages inside the
# package source. The former CI kept its cached dependency library here
# (SEOR-dyzgzyot); punycoder hit the WARNING for real before this was added.
^\.r-lib$
# R CMD check output, written into the project directory so a CI job can
# upload it as an artifact, as fleet-ci's FLEET_CHECK_DIR.
^check$
# In a git worktree .git is a regular file (a gitdir: pointer), which R CMD build
# does not exclude the way it does a .git directory; it would ship as a hidden file.
^\.git$
# Logs and build output for the house workflow. Without this, R CMD build copies
# it into the tarball and the check reports a top-level-files NOTE.
^tmp$
# The fleet-ci local gate: the vendored runner and its settings, per
# fleet-ci's README, "Adopting the template". Every line here is a regular
# expression, comments included: no unbalanced brackets.
^\.fleet-ci$
^\.fleet-ci\.yml$
# fleet-ci's t2-sanitizers job installs the dependencies into
# $CI_PROJECT_DIR/.fleet-lib and then runs `R CMD build .` there.
^\.fleet-lib$
